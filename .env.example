# Public Vite vars for local dev and builds. Copy to .env for local runs.
# Keep values blank until provisioned. Never put secrets in VITE_ vars.
# VITE_PUBLIC_SITE_URL is derived automatically from the PUBLIC_SITE_URL build
# variable in vite.config.ts. Do not set it manually.
# Local builds: PUBLIC_SITE_URL="" npm run build (empty withholds canonical/sitemap).
# Example: PUBLIC_SITE_URL="https://oasis-dev.oasishub.workers.dev" npm run build
VITE_TURNSTILE_SITE_KEY=""
