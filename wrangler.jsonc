{
  // Oasis.dev Worker config. JSONC allows comments. Do not commit secrets here.
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.jsonc.json",
  "name": "oasis-dev",
  "main": "workers/app.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    // "none" lets the Worker return real 404s for SSR routes.
    // Do not use single-page-application fallback: private APIs must never return HTML.
    "not_found_handling": "none",
    // Worker first only for APIs and the private admin shell.
    // Public "/" and hashed "/assets/*" stay asset-first for speed and SEO.
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oasis-dev",
      // Local placeholder. Replace with the real D1 database_id before any deploy.
      // See README: no deploy before Domain, Access, and D1 are set.
      "database_id": "8b599148-6416-4087-8c48-0c029b84e140",
      "migrations_dir": "./migrations"
    }
  ],
  // Rate limiting binding used by backend handlers via env.RATE_LIMITER.
  // Namespace is a user-chosen positive integer as a string, unique in your account.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "vars": {
    // PUBLIC_SITE_URL is intentionally not a runtime var here. It is a public
    // Build variable (Workers Builds dashboard, shell env locally), not a secret.
    // vite.config.ts derives VITE_PUBLIC_SITE_URL from it at build time and
    // scripts/generate-sitemap.mjs builds the sitemap from the same value.
    // Change the URL in Workers Builds, then rebuild/redeploy.
    // Example: "https://oasis-dev.oasishub.workers.dev".
    // Cloudflare Access team domain and app audience for the /admin shell and /api/admin/* APIs.
    // Backend vars use these exact names. Do not rename. Secrets go via wrangler secret put.
    "ACCESS_TEAM_DOMAIN": "https://rapid-feather-5044.cloudflareaccess.com",
    "ACCESS_AUD": "86ff59cfc97d8c4b5a8c2d03d1a159b7ec11a4f15d5732fee523c5debe1ced28",
    "OWNER_EMAIL": "oasiscreationshub@gmail.com",
    "FROM_EMAIL": ""
  },
  // Secrets (never in this file):
  // TURNSTILE_SECRET_KEY, RESEND_API_KEY via `wrangler secret put` and local .dev.vars (see .dev.vars.example).
  "observability": { "enabled": true }
}
