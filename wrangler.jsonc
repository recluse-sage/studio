{
  // Oasis.dev Worker config. JSONC allows comments. Do not commit secrets here.
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.jsonc.json",
  "name": "oasis-dev",
  "main": "workers/app.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    // "none" lets the Worker return real 404s for SSR routes.
    // Do not use single-page-application fallback: private APIs must never return HTML.
    "not_found_handling": "none",
    // Worker first only for APIs and the private admin shell.
    // Public "/" and hashed "/assets/*" stay asset-first for speed and SEO.
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oasis-dev",
      // Local placeholder. Replace with the real D1 database_id before any deploy.
      // See README: no deploy before Domain, Access, and D1 are set.
      "database_id": "LOCAL-PLACEHOLDER-REPLACE-ME",
      "migrations_dir": "./migrations"
    }
  ],
  // Rate limiting binding used by backend handlers via env.RATE_LIMITER.
  // Namespace placeholder must be replaced with a real provisioned namespace before deploy.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "LOCAL-PLACEHOLDER-REPLACE-ME",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "vars": {
    // Public canonical base. Empty until the owner sets the real domain.
    // Example after setup: "https://oasis.dev". Never hardcode a domain you do not own.
    // Sitemap and canonical tags stay disabled while this is empty. See scripts/generate-sitemap.mjs.
    "PUBLIC_SITE_URL": "",
    // Cloudflare Access team domain and app audience for the /admin shell and /api/admin/* APIs.
    // Backend vars use these exact names. Do not rename. Secrets go via wrangler secret put.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": "",
    "FROM_EMAIL": ""
  },
  // Secrets (never in this file):
  // TURNSTILE_SECRET_KEY, RESEND_API_KEY via `wrangler secret put` and local .dev.vars (see .dev.vars.example).
  "observability": { "enabled": true }
}
