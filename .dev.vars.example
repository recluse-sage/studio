# Local Worker vars for `wrangler dev`. Copy to .dev.vars for local runs.
# Keep all values blank until provisioned. Never commit .dev.vars or real secrets.
# PUBLIC_SITE_URL is build-time only (Workers Builds dashboard, shell env locally),
# not a runtime var, so it is intentionally absent here.
ACCESS_TEAM_DOMAIN=""
ACCESS_AUD=""
TURNSTILE_SECRET_KEY=""
RESEND_API_KEY=""
OWNER_EMAIL=""
FROM_EMAIL=""
